{
  "name": "Dhyey Clinic Management System",
  "short_name": "Dhyey CMS",
  "description": "Next-Generation Clinical Management, Digital Prescriptions, Billing & Doctor OPD Management",
  "start_url": "/pages/login.html",
  "scope": "/",
  "id": "/index.html",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "background_color": "#f8fafc",
  "theme_color": "#095c54",
  "orientation": "any",
  "lang": "en",
  "dir": "ltr",
  "categories": ["medical", "health", "productivity", "utilities", "business"],
  "icons": [
    {
      "src": "/assets/icons/icon.svg",
      "sizes": "192x192 512x512",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/assets/icons/icon-maskable.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Doctor Dashboard",
      "short_name": "Dashboard",
      "description": "Open Doctor Clinical Dashboard",
      "url": "/index.html?view=dashboard",
      "icons": [{ "src": "/assets/icons/icon.svg", "sizes": "192x192" }]
    },
    {
      "name": "New Family Registration",
      "short_name": "Add Family",
      "description": "Register New Family Head & Members",
      "url": "/index.html?view=family",
      "icons": [{ "src": "/assets/icons/icon.svg", "sizes": "192x192" }]
    },
    {
      "name": "Patient Record",
      "short_name": "Case Record",
      "description": "Open OPD Patient Examination & Rx",
      "url": "/index.html?view=case",
      "icons": [{ "src": "/assets/icons/icon.svg", "sizes": "192x192" }]
    }
  ],
  "prefer_related_applications": false
}
